# ==============================================================================
# ReachInbox Email Scheduler Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Generate secure random 32-byte (64 hex characters) secrets for:
#   SESSION_SECRET and TOKEN_ENCRYPTION_KEY
# You can generate them with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# PostgreSQL Database (Prisma ORM)
# Default Docker Compose PostgreSQL credentials
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public

# Redis Connection (BullMQ Queue, Distributed Locks, Rate Limiting)
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (MUST BE 64 hex characters / 32 bytes for AES-256-GCM)
SESSION_SECRET=e7c8b2149dfa2c5a0899015c7e163b7e9f3b55a18a939f60cb05c083658eb1a4
TOKEN_ENCRYPTION_KEY=4a2e5d9c7f1b8a3e0f5c9d2b7e4a1f8c6e3b0a7d9f2c5e8a1b4d7f0c3e6a9b2d

# Google OAuth 2.0 / OpenID Connect
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# SMTP Provider Settings (Ethereal Email for Development / Testing)
# Generate test account at https://ethereal.email/create or run npm run seed
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
SMTP_FROM_NAME="ReachInbox Outbox"
SMTP_FROM_EMAIL=outbox@reachinbox.test

# Elasticsearch (Search & Indexing Engine)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=reachinbox_es_password
ELASTICSEARCH_INDEX=reachinbox_emails

# Queue Worker Concurrency & Throttling
# Worker concurrency defines parallel BullMQ jobs processed per worker process
WORKER_CONCURRENCY=2

# Minimum Delay (in milliseconds) between sends for the same sender across workers
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Distributed Hourly Quota per sender (resets at start of each UTC hour)
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Slack Integration (OAuth 2.0 & Alerts)
# Obtain from Slack API Dashboard (https://api.slack.com/apps)
# Scopes required: chat:write, channels:read, incoming-webhook
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_CALLBACK_URL=http://localhost:4000/api/integrations/slack/callback
SLACK_SCOPES=chat:write,channels:read,incoming-webhook
SLACK_DEFAULT_CHANNEL=#email-alerts

# Admin & Bull Board Queue Dashboard Access
ADMIN_SECRET=reachinbox_admin_queue_2026
